# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Required for persistent PostgreSQL database, Auth & Storage)
# Configure these in AI Studio Secrets or your server environment.
# NEVER prefix SUPABASE_SECRET_KEY with VITE_ or expose it to browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional browser-accessible public Supabase config (safe publishable values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional local preview admin credentials override (used only when Supabase is not yet connected)
ADMIN_PASSCODE=

# Optional External Notification Providers (Inactive until configured)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_API_KEY=
SMS_SENDER_ID=
